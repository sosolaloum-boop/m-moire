# Local development only (.env is gitignored). The managed deployment authenticates
# with the platform-injected service-account token: no API key belongs in the image.
MISTRAL_API_KEY=

# Gmail OAuth2 credentials for the mailbox the workflow polls (scope
# https://www.googleapis.com/auth/gmail.modify). Unattended runs read them from
# workspace secrets bound as these environment variables on the deployment.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# Short-lived alternative for a one-off local test:
# GMAIL_ACCESS_TOKEN=
